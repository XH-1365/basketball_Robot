# ---- Keil MDK / ARMCC 编译中间产物与输出 ----
*.o
*.obj
*.d
*.crf
*.dep
*.lnp
*.ln
*.axf
*.elf
*.bin
*.hex
*.map
*.lst
*.iex
*.htm
*.build_log.htm
*.scvd
*.dbgconf
build.log
build_*.log
*.build.log
DebugConfig/

# Keil 用户本地状态（窗口布局等）
*.uvguix.*
*.uvgui.*
*.uvgui
*.bak
*.bak_before_*

# uvoptx 是"目标选项/调试器配置"，CubeMX 更新 Keil 工程时**必须**能读到它，
# 空的或缺失都会让生成报错(KeilGenerator.removeFiles NPE / setConfigs FileNotFound)。
# 所以这一个文件要入库，其余 uvoptx 仍忽略。
*.uvoptx
!MDK-ARM/ctrl_2005.uvoptx

# ---- CubeMX / IDE 元数据 ----
# .mxproject 记录"生成过哪些文件"，入库后重新生成的结果才可复现(否则每次当新文件重写)
.settings/
MXTmpFiles/

# ---- CubeMX 无头生成脚本（内含本机绝对路径） ----
gen.txt

# ---- 压缩包与备份 ----
*.zip
*.rar
*.7z

# ---- 系统 / 编辑器 ----
Thumbs.db
Desktop.ini
.DS_Store
*~
*.swp

# ---- 本地调试脚本（含本机绝对路径，不上传） ----
_read_bt.py
_pid_tuner*.py
MDK-ARM/*.log

# ---- 一次性改码补丁脚本（锚点替换工具，跑完即弃） ----
_patch_*.py
